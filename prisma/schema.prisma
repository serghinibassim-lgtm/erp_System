Pgenerator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Produit {
  id               String   @id @default(cuid())
  code             String   @unique
  designation      String
  categorie        String
  unite            String
  prixAchatRef     Decimal  @map("prix_achat_ref")
  prixVenteRef     Decimal  @map("prix_vente_ref")
  stockInitial     Int      @map("stock_initial")
  stockMin         Int      @default(0) @map("stock_min")
  creeLe           DateTime @default(now()) @map("cree_le")
  misAJourLe       DateTime @updatedAt @map("mis_a_jour_le")

  achats         Achat[]
  ventes         Vente[]
  stock          Stock?
  historiquePrix HistoriquePrix[]

  @@map("produits")
}

model Achat {
  id              String    @id @default(cuid())
  date            DateTime
  numeroDocument  String?   @map("numero_document")
  fournisseurId   String?   @map("fournisseur_id")
  produitId       String    @map("produit_id")
  quantite        Int
  prixUnitaire    Decimal   @map("prix_unitaire")
  montantTotal    Decimal   @map("montant_total")
  modePaiement    String?   @map("mode_paiement")
  observation     String?
  ecart           Decimal?
  alerte          Boolean?

  fournisseur Fournisseur? @relation(fields: [fournisseurId], references: [id])
  produit     Produit      @relation(fields: [produitId], references: [id])

  @@map("achats")
}

model Vente {
  id                  String    @id @default(cuid())
  date                DateTime
  numeroVente         String?   @map("numero_vente")
  clientId            String?   @map("client_id")
  produitId           String    @map("produit_id")
  quantite            Int
  prixUnitaire        Decimal   @map("prix_unitaire")
  montantTotal        Decimal   @map("montant_total")
  modePaiement        String?   @map("mode_paiement")
  dateLimitePaiement  DateTime? @map("date_limite_paiement")
  paye                Boolean   @default(false)
  datePaiement        DateTime? @map("date_paiement")
  observation         String?
  ecart               Decimal?
  alerte              Boolean?

  client  Client?  @relation(fields: [clientId], references: [id])
  produit Produit  @relation(fields: [produitId], references: [id])

  @@map("ventes")
}

model Stock {
  id              String  @id @default(cuid())
  produitId       String  @unique @map("produit_id")
  stockInitial    Int     @map("stock_initial")
  totalAchats     Int     @default(0) @map("total_achats")
  totalVentes     Int     @default(0) @map("total_ventes")
  stockActuel     Int     @map("stock_actuel")
  statutStock     String  @default("OK") @map("statut_stock")
  valeurAchat     Decimal @map("valeur_achat")
  valeurVente     Decimal @map("valeur_vente")
  margePotentielle Decimal @map("marge_potentielle")

  produit Produit @relation(fields: [produitId], references: [id])

  @@map("stocks")
}

model Fournisseur {
  id        String @id @default(cuid())
  code      String @unique
  nom       String
  telephone String
  adresse   String?
  ice       String?

  achats Achat[]

  @@map("fournisseurs")
}

model Client {
  id        String @id @default(cuid())
  code      String @unique
  nom       String
  telephone String
  adresse   String?

  ventes Vente[]

  @@map("clients")
}

model Utilisateur {
  id         String   @id @default(cuid())
  nom        String
  email      String   @unique
  motDePasse String   @map("mot_de_passe")
  role       String   @default("USER")
  creeLe     DateTime @default(now()) @map("cree_le")
  misAJourLe DateTime @updatedAt @map("mis_a_jour_le")

  @@map("utilisateurs")
}

model Parametre {
  id     String @id @default(cuid())
  cle    String @unique
  valeur String

  @@map("parametres")
}

model Sequence {
  cle      String @id
  prefixe  String
  annee    Int
  dernierN Int    @default(0)

  @@map("sequences")
}

model HistoriquePrix {
  id               String    @id @default(cuid())
  produitId        String    @map("produit_id")
  ancienPrixAchat  Decimal?  @map("ancien_prix_achat")
  nouveauPrixAchat Decimal?  @map("nouveau_prix_achat")
  ancienPrixVente  Decimal?  @map("ancien_prix_vente")
  nouveauPrixVente Decimal?  @map("nouveau_prix_vente")
  dateModification DateTime  @default(now()) @map("date_modification")
  raison           String?

  produit Produit @relation(fields: [produitId], references: [id])

  @@map("historique_prix")
}

